{
  "name": "harness-stats",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Codex Task Ledger — TS 轨（P1）：零侵入 token/编排账本 + 实时仪表盘。Python 轨为冻结 oracle。",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "update": "node apps/cli/src/main.ts update",
    "serve": "node apps/cli/src/main.ts serve",
    "prices": "node apps/cli/src/main.ts prices",
    "reconcile": "node apps/cli/src/main.ts reconcile",
    "env": "node apps/cli/src/main.ts env",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "golden": "node scripts/golden.ts",
    "build:web": "npm run build -w @hs/web",
    "start": "npm run build:web && npm run serve"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
